{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coldshark699",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a92799a1-ada5-4185-8b74-f9a9b3c340fa","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "828ecdcd7c9b4eb1a9a2f08843c964b6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
